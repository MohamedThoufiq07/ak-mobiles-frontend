# Production API base URL — used by `npm run build` (Vite reads .env.production).
# Set this in the Vercel frontend project's Environment Variables to your deployed
# Django backend URL WITH the /api suffix, e.g.:
#   VITE_API_URL=https://ak-mobiles-backend.vercel.app/api
# The placeholder below is a safe default that fails loudly if left unset.
VITE_API_URL=__SET_IN_VERCEL__
